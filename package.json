{
  "name": "dacospace",
  "version": "0.1.0",
  "description": "Daily learning loop for backend engineers: a lesson, a hands-on lab and a system design interview question per day. Next.js app plus a stdio MCP server.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tolgazorlu/dacospace.git"
  },
  "private": true,
  "scripts": {
    "dev": "next dev -p 4120 -H 127.0.0.1",
    "build": "next build",
    "start": "next start -p 4120 -H 127.0.0.1",
    "lint": "eslint",
    "test": "vitest run",
    "mcp": "tsx mcp/server.mts",
    "typecheck": "tsc --noEmit",
    "setup": "bash scripts/setup.sh",
    "sync-content": "node scripts/sync-content.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.55.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.4",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@9.15.9"
}
